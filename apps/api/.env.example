# Database
# Local Docker Compose: point to the db container
# Railway: set DATABASE_URL=${{Postgres.DATABASE_URL}} (reference variable, private network)
DATABASE_URL=${{ Postgres.DATABASE_PRIVATE_URL }}

# Postgres container credentials (used by compose.yaml only, not needed on Railway)
POSTGRES_USER=brewnal
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=brewnal

# JWT (min 32 chars; generate with: openssl rand -base64 48)
JWT_SECRET="change-this-to-a-strong-secret"
JWT_EXPIRES_IN="7d"

# Photo storage (S3-compatible bucket)
# Railway: set in .railway/railway.ts as references to the bucket, never as literal values
# Local: leave empty to disable photo routes (they return 503), or point at a local MinIO.
# Do not copy the production bucket credentials into a local .env
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# OCR.space
OCR_SPACE_API_KEY="helloworld"

# App
# On Railway, PORT is set in .railway/railway.ts to match the domain's target port
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
APP_NAME="Brewnal"
